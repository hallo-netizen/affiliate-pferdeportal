              "claims": [
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-001",
                  "locator": "Light Duty/Trimmers; Medium Duty; Heavy Duty",
                  "source_id": "SRC-WAHL-HORSE-CLIPPER-BUYING-GUIDE",
                  "statement": "Die passende Geräteklasse hängt vor allem davon ab, wie oft geschoren wird, welche Schur geplant ist und wie anspruchsvoll das Fell ist: Trimmer sind eher für Feinarbeit und kurze, feine Felle gedacht, mittlere Geräte für allgemeine Schur und Heavy-Duty-Geräte für häufige oder besonders anspruchsvolle Einsätze.",
                  "subject_scope": "Auswahl der Geräteklasse für Pferdeschermaschinen",
                  "time_scope": "allgemeine Produktauswahl; Quelle abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-002",
                  "locator": "Factors to consider; Power Source; Horse’s Temperament",
                  "source_id": "SRC-WAHL-WHICH-CLIPPER-RIGHT",
                  "statement": "Bei der Auswahl sind Gewicht und Balance, Stromversorgung sowie Temperament des Pferdes relevant; leisere und vibrationsärmere Geräte können bei empfindlichen oder nervösen Pferden vorteilhaft sein.",
                  "subject_scope": "Handhabung, Stromversorgung und Pferdeverträglichkeit",
                  "time_scope": "allgemeine Produktauswahl; Quelle abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-003",
                  "locator": "Power Source",
                  "source_id": "SRC-WAHL-WHICH-CLIPPER-RIGHT",
                  "statement": "Akkugeräte bieten mehr Bewegungsfreiheit, während netzbetriebene Modelle nicht von der Akkulaufzeit abhängen; die Wahl sollte sich nach Einsatzort und geplanter Schurdauer richten.",
                  "subject_scope": "Akku versus Netzbetrieb",
                  "time_scope": "allgemeine Produktauswahl; Quelle abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-004",
                  "locator": "Fine coated horses; Medium coated horses; Thick coated horses",
                  "source_id": "SRC-LISTER-COAT-TYPES",
                  "statement": "Felltyp und Fellstärke beeinflussen die Wahl des Schermessers: Für dickes oder grobes Fell empfiehlt Lister gröbere Messer mit weniger Zähnen, um leichter durch das Fell zu kommen und den Motor weniger zu belasten.",
                  "subject_scope": "Schermesser passend zum Felltyp",
                  "time_scope": "Herstellerleitfaden vom 17.10.2023; abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-005",
                  "locator": "Covercote; A2F/AC Fine; A2/AC Medium",
                  "source_id": "SRC-WAHL-LISTER-BLADES",
                  "statement": "Unterschiedliche Messer lassen unterschiedlich viel Fell stehen; als Beispiele nennt der Hersteller etwa 1,4 mm für ein feines Messer, 2,5 mm für ein mittleres Messer und 5 mm für ein Covercote-Messer.",
                  "subject_scope": "Schnittlängen verschiedener Pferde-Schermesser",
                  "time_scope": "produktspezifische Herstellerangaben; Quelle abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-006",
                  "locator": "Oiling & Cleaning Your Blades",
                  "source_id": "SRC-WAHL-SPRING-TRIMMING",
                  "statement": "Schermesser sollen regelmäßig gereinigt und geölt werden; der Hersteller empfiehlt Öl vor, während und nach der Schur, um einen gleichmäßigen Lauf zu unterstützen und Überhitzung sowie Verschleiß zu reduzieren.",
                  "subject_scope": "Pflege von Schermessern",
                  "time_scope": "allgemeine Wartungshinweise; Quelle abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-007",
                  "locator": "Start with a Clean Coat BEFORE Clipping; Using the right gear",
                  "source_id": "SRC-WAHL-SHINY-COAT",
                  "statement": "Ein gründlich gereinigtes Fell und scharfe, gepflegte Messer verbessern das Schurergebnis; Schmutz kann die Messer schneller stumpf machen, stumpfe Messer können Haare eher ziehen und ein ungleichmäßiges Schnittbild verursachen.",
                  "subject_scope": "Vorbereitung von Fell und Messern",
                  "time_scope": "allgemeine Schurvorbereitung; Quelle abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-008",
                  "locator": "Preparation for clipping; Clipping horses; Care after clipping",
                  "source_id": "SRC-BHS-COACH-GUIDANCE",
                  "statement": "Zur sicheren Vorbereitung gehören unter anderem ein geeigneter Arbeitsplatz, die Kontrolle von Kabeln beziehungsweise Stromversorgung, korrekt montierte und geölte Messer, Ersatzmesser sowie die Beobachtung von Temperatur und Zustand der Maschine während der Schur.",
                  "subject_scope": "Sicherheit und Vorbereitung beim Pferdescheren",
                  "time_scope": "BHS Ausbildungsleitfaden; abgerufen 2026-09-30"
                },
                {
                  "claim_status": "FULLY_SUPPORTED",
                  "fact_id": "FACT-CLIPPER-009",
                  "locator": "Assess your requirements",
                  "source_id": "SRC-LISTER-FIRST-TIME",
                  "statement": "Der Einsatzort ist ein praktisches Auswahlkriterium: Wenn kein Netzstrom verfügbar ist, kann ein kabelloses Gerät die passendere Lösung sein.",
                  "subject_scope": "Einsatzort und Stromversorgung",
                  "time_scope": "Herstellerleitfaden vom 29.06.2021; abgerufen 2026-09-30"
                }
