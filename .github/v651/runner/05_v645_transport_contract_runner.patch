+  printf 'COUNT=7 FAIL=7 ASSERTIONS=56\nOLD_BROWSER_EXECUTOR_CONTRACT=EXPECTED_RED\n' >> "$out/old_browser_transport_red.log"
+
+  # Versioned V6.51 successors preserve all 56 still-valid assertions; only the
