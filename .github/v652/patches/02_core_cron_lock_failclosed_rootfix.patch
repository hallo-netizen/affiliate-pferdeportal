+    private function ebay_run_fail_background_dispatch($code, $details = array()) {
+        $run = $this->ebay_run_load();
+        if (!$this->ebay_run_is_active($run)) { return false; }
+        if (function_exists('wp_clear_scheduled_hook')) { wp_clear_scheduled_hook(self::EBAY_WORKER_HOOK); }
+        $this->ebay_worker_dispatch_at = 0;
