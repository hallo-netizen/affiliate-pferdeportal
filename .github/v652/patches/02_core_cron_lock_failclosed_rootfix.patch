+    /**
+     * If core Cron is already locked, give the existing owner a short bounded
+     * chance to consume our due event or release the lock. A fresh/orphan lock
+     * must never be mistaken for successful dispatch: unresolved contention is
+     * converted into a clean failed run, preserving the safe public checkpoint.
+     */
+    private function ebay_run_wait_for_cron_lock_resolution($initial_lock, $max_wait_seconds = 5) {
+        $deadline = microtime(true) + max(1, absint($max_wait_seconds));
+        $seen_lock = (string)$initial_lock;
+        do {
+            $run = $this->ebay_run_load();
+            if (!$this->ebay_run_is_active($run)) { return true; }
+            $next = function_exists('wp_next_scheduled') ? wp_next_scheduled(self::EBAY_WORKER_HOOK) : false;
+            if ($next === false || absint($next) > time()) { return true; }
+            $lock = function_exists('get_transient') ? get_transient('doing_cron') : false;
+            if (empty($lock) || (string)$lock !== $seen_lock) {
+                if (function_exists('spawn_cron')) {
+                    $spawned = spawn_cron(microtime(true));
+                    if ($spawned !== false) { return true; }
+                }
+                $seen_lock = (string)$lock;
+            }
+            usleep(250000);
+        } while (microtime(true) < $deadline);
+
+        $run = $this->ebay_run_load();
+        $next = function_exists('wp_next_scheduled') ? wp_next_scheduled(self::EBAY_WORKER_HOOK) : false;
+        if (!$this->ebay_run_is_active($run) || $next === false || absint($next) > time()) { return true; }
+        return $this->ebay_run_fail_background_dispatch(
+            'background_transport_lock_timeout',
+            array('transport'=>'wp_cron','next_event'=>absint($next),'lock'=>(string)(function_exists('get_transient') ? get_transient('doing_cron') : ''))
+        );
+    }
