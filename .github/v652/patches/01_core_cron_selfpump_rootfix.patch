+    private function ebay_run_register_background_kick($when) {
+        $when = absint($when);
+        if ($when <= 0 || !function_exists('add_action')) { return false; }
+        if (empty($this->ebay_worker_kick_at) || $when < absint($this->ebay_worker_kick_at)) {
