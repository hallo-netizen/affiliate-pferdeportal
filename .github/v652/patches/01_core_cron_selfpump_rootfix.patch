+        // response has finished, so the browser is never held open as a worker.
+        if ($wait > 0 && $wait <= 2) { usleep(($wait * 1000000) + 100000); }
+        if ($next > time()) { return false; }
+        $this->ebay_worker_kick_at = 0;
+        return spawn_cron(time()) !== false;
