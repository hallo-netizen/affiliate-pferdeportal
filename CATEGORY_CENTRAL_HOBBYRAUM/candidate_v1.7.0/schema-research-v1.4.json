{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Affiliate Portal Research Package 1.4",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "master_contract_id",
    "package_id",
    "source_draft",
    "project",
    "market",
    "workflow_contract",
    "existing_inventory",
    "research_provider",
    "global_coverage_binding",
    "global_coverage_package",
    "global_discovery",
    "planned_keyword_overview",
    "cluster_research",
    "research_summary",
    "provider_evidence",
    "audit_trail",
    "content_sha256"
  ],
  "properties": {
    "format": {
      "const": "affiliate-portal-research-package"
    },
    "schema_version": {
      "const": "1.4"
    },
    "package_id": {
      "type": "string",
      "minLength": 3
    },
    "source_draft": {
      "type": "object",
      "required": [
        "package_id",
        "content_sha256",
        "research_scope_sha256",
        "package"
      ],
      "properties": {
        "package_id": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "research_scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package": {
          "type": "object"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "scope",
        "target_market",
        "language_code",
        "exclusions",
        "discovery_seed_keywords"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "target_market": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 2
        },
        "exclusions": {
          "type": "array"
        },
        "discovery_seed_keywords": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "market": {
      "type": "object",
      "required": [
        "location_name",
        "language_code"
      ],
      "properties": {
        "location_name": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "workflow_contract": {
      "type": "object"
    },
    "existing_inventory": {
      "type": "object"
    },
    "research_provider": {
      "type": "object"
    },
    "global_discovery": {
      "type": "object",
      "required": [
        "seed_keywords",
        "limit",
        "items",
        "cost_usd"
      ]
    },
    "planned_keyword_overview": {
      "type": "object",
      "required": [
        "keyword_count",
        "runs",
        "items"
      ]
    },
    "cluster_research": {
      "type": "object",
      "required": [
        "cluster_count",
        "limit_per_cluster",
        "clusters"
      ]
    },
    "research_summary": {
      "type": "object"
    },
    "provider_evidence": {
      "type": "object"
    },
    "audit_trail": {
      "type": "array"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "global_coverage_binding": {
      "type": "object",
      "required": [
        "package_id",
        "content_sha256",
        "project_discovery_scope_sha256"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 3
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_discovery_scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "global_coverage_package": {
      "type": "object"
    },
    "master_contract_id": {
      "const": "ALLGEMEINGUELTIGER_KATEGORIE_MASTER_016_WORKFLOW_HARDLOCK"
    }
  }
}
