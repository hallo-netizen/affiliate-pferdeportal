{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Affiliate Portal Global Coverage Package 1.0",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "master_contract_id",
    "package_id",
    "project",
    "project_discovery_scope_sha256",
    "source_draft",
    "market",
    "global_discovery",
    "provider_evidence",
    "research_summary",
    "audit_trail",
    "content_sha256"
  ],
  "properties": {
    "format": {
      "const": "affiliate-portal-global-coverage-package"
    },
    "schema_version": {
      "const": "1.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 3
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "scope",
        "exclusions",
        "discovery_seed_keywords",
        "target_market",
        "language_code"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "target_market": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 2
        },
        "exclusions": {
          "type": "array"
        },
        "discovery_seed_keywords": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "project_discovery_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_draft": {
      "type": "object",
      "required": [
        "package_id",
        "content_sha256",
        "package"
      ]
    },
    "market": {
      "type": "object",
      "required": [
        "location_name",
        "language_code"
      ],
      "properties": {
        "location_name": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "global_discovery": {
      "type": "object",
      "required": [
        "seed_keywords",
        "limit",
        "items",
        "cost_usd"
      ]
    },
    "provider_evidence": {
      "type": "object"
    },
    "research_summary": {
      "type": "object"
    },
    "audit_trail": {
      "type": "array"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "master_contract_id": {
      "const": "ALLGEMEINGUELTIGER_KATEGORIE_MASTER_016_WORKFLOW_HARDLOCK"
    }
  }
}
