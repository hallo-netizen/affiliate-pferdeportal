          "claims": [
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"84ac9373ca4d1136ef4dcb03691b5ae83f82724c8a6c118008c5cc4b327303b5","fact_id":"KZ_F1","locator":"Abschnitt „Wie wirkt ein Kappzaum?“","source_id":"CAVALLO_KAPPZAUM_20260731","statement":"Über den mittleren Ring am Nasenriemen des Kappzaums lassen sich Impulse auf Nase und Genick übertragen, sodass das Pferd über die Longenverbindung gesteuert werden kann.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"},
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"a48ef1ce575eb9c424e455262d0d16bcf1d49af45c073c97687d72bb59aee0b8","fact_id":"KZ_F2","locator":"Abschnitte „Welcher Kappzaum eignet sich zum Longieren?“ und „Wie soll ein Kappzaum sitzen?“","source_id":"CAVALLO_KAPPZAUM_20260731","statement":"Für die Longenarbeit sollte ein Kappzaum stabil und passend sitzen; ein schlecht sitzender oder bei Zug verdrehter Zaum kann die Einwirkung verschlechtern und dem Pferd Probleme bereiten.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"},
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"f1edcf93c1437ac503e376c38881053fe80e535fd780e649dddb7f50071546a7","fact_id":"KZ_F3","locator":"Abschnitt „Wie soll ein Kappzaum sitzen?“","source_id":"CAVALLO_KAPPZAUM_20260731","statement":"Zwischen Jochbein und Nasenriemen sollten etwa zwei Finger Abstand liegen, und der mittlere Ring sollte auf dem Nasenrücken bleiben.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"},
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"020a291a38db5ed6b08f84a0037bbf255bbaa250a5f1c3a576b8828051a08419","fact_id":"KZ_F4","locator":"Abschnitt „Vorübung 1: Vorhand bewegen“","source_id":"CAVALLO_KAPPZAUM_20260731","statement":"Vor dem Longieren am Kappzaum sollte das Pferd grundlegende Bodenübungen wie Antreten, Halten, Weichen, Rückwärtsrichten und Schritt-Trab-Übergänge sicher beherrschen.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"},
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"502dfd95e95057ba609153968be32644c0192477f158801c4d3b2fe5564f588a","fact_id":"KZ_F5","locator":"Abschnitt „Erste Schritte an Longe und Kappzaum“","source_id":"CAVALLO_KAPPZAUM_20260731","statement":"Der Einstieg in die Longenarbeit kann im Schritt auf kleineren Zirkeln mit konstanter Verbindung zwischen Longe und Kappzaum beginnen; anfangs kann der Mensch nah am Pferd mitgehen und gerade Linien einbauen.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"},
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"f7ed970fffac82cfcd0de46ca12c0efa6b7be4b972790dae987a479150fa8363","fact_id":"KZ_F6","locator":"Abschnitt „Schritt und Trab in Dehnung“","source_id":"CAVALLO_KAPPZAUM_20260731","statement":"Erst wenn das Pferd im Schritt die Dehnung sicher hält, sollte es in kurzen Reprisen antraben; Galopp folgt erst, wenn Schritt und Trab ausbalanciert und stabil gelingen.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"},
            {"article_types":["FAQ"],"claim_status":"FULLY_SUPPORTED","evidence_text_sha256":"5b8f825dd624fc33f32c412a63c7d3b45f74ee431a05a7e1a2869f33320777e7","fact_id":"KZ_F7","locator":"Tabelle Grundausrüstung, Zeile „Trense oder Kappzaum“","source_id":"KRAEMER_LONGIEREN_20261001","statement":"Beim Longieren mit Kappzaum wird die Longe grundsätzlich in den mittleren Ring eingeschnallt.","subject_scope":"wie_longiert_man_ein_pferd_mit_einem_kappzaum","time_scope":"RETRIEVED_2026-10-01"}
