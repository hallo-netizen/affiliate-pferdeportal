              "fact_id": "FACT-CLIPPER-006",
              "source_id": "SRC-LISTER-HOT-BLADES-20260930",
              "locator": "You’re not using enough oil; You’re using the wrong blades for the application",
              "statement": "Regelmäßiges Ölen reduziert Reibung und Hitze; zu wenig Öl oder ein unpassendes Messer kann dazu beitragen, dass Messer und Maschine stärker belastet werden.",
              "claim_status": "FULLY_SUPPORTED",
              "subject_scope": "Wartung und Wärmeentwicklung",
              "time_scope": "allgemeine Schurpraxis"
