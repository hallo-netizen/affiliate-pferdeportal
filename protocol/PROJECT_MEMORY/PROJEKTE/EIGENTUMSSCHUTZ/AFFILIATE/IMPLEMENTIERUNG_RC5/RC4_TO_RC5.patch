+    /** Zero-catalog automatic fallback: a safe category Amazon search, never a fabricated product. */
+    private function hb_amazon_category_search_fallback($context, $slot_type) {
+        if (!$this->hb_amazon_ready() || !is_array($context)) { return ''; }
+        if (sanitize_key((string)$slot_type) !== 'product_after_category_tiles') { return ''; }
+        // A real WP category with a product-family mapping from Hab's own source.
+        if (($context['post_type'] ?? '') !== 'category_archive') { return ''; }
+        $family = sanitize_key((string)($context['product_family_slug'] ?? ''));
+        if ($family === '') { return ''; }
+        $name = sanitize_text_field((string)($context['primary_name'] ?? ''));
+        if ($name === '' || strlen($name) > 150) { return ''; }
+        // Only a verified product-family category. The Amazon search page
+        // may show unrelated offers: do NOT present it as a specific product.
+        $url = 'https://www.amazon.de/s?k=' . rawurlencode($name) . '&tag=' . rawurlencode($this->hb_amazon_tag());
+        return '<div class="ppar-affiliate-slot ppar-slot-product_after_category_tiles ppar-hab-amazon-search" data-ppar-slot="product_after_category_tiles">'
+            . '<div class="ppar-affiliate-label">Anzeige</div>'
+            . '<div class="ppar-affiliate-content"><a href="' . esc_url($url) . '" target="_blank" rel="sponsored nofollow noopener noreferrer">'
+            . 'Passende Angebote bei Amazon suchen</a></div></div>';
+    }
