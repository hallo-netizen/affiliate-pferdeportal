+    /** Published posts re-use the same Hab category catalog and DataForSEO worker.
+     * The article itself supplies extra query specificity, never a new product catalog.
+     * Return null for general advice, wrong categories or non-commercial content.
+     */
+    private function hb_amazon_article_topic($post) {
+        if (!is_object($post) || empty($post->ID)) { return null; }
+        $id=absint($post->ID);
+        if (!function_exists('get_post_status') || !function_exists('get_post_type') ||
+            get_post_status($id)!=='publish' || get_post_type($id)!=='post') { return null; }
+        if ((string)get_post_meta($id,'_hbdp_article_no_ads',true)==='1' ||
+            (function_exists('hbdp_article_is_urgent') && hbdp_article_is_urgent($post))) { return null; }
+        if (!class_exists('PPAR_Portal_Source') || !method_exists('PPAR_Portal_Source','catalog')) { return null; }
+        $catalog=PPAR_Portal_Source::catalog();
+        if (is_wp_error($catalog) || !is_array($catalog)) { return null; }
+        $products=array();
+        foreach ((array)($catalog['product_targets'] ?? array()) as $row) {
+            $slug=sanitize_key((string)($row['category_slug'] ?? ''));
+            $family=sanitize_text_field((string)($row['title'] ?? ''));
+            if ($slug!=='' && $family!=='' && strlen($family)<=90) { $products[$slug]=$family; }
+        }
+        // Only a direct WordPress category that exists as a product target in
+        // the SAME revision-bound Hab portal catalog can authorize this search.
+        $terms=get_the_terms($id,'category');
+        if (is_wp_error($terms) || !is_array($terms)) { return null; }
+        $title=sanitize_text_field((string)($post->post_title ?? ''));
+        $title=trim(preg_replace('/\s+/u',' ',$title));
+        if (strlen($title)<8 || strlen($title)>180) { return null; }
+        $title_terms=explode(' ',$this->hb_amazon_normalize_title($title));
+        foreach ($terms as $term) {
+            $slug=sanitize_key((string)($term->slug ?? ''));
+            $family=(string)($products[$slug] ?? '');
+            if ($family==='') { continue; }
+            $matched=true;
+            foreach (explode(' ',$this->hb_amazon_normalize_title($family)) as $needle) {
+                if ($needle==='') { continue; }
+                $found=false;
+                foreach ($title_terms as $word) {
+                    if (in_array($word,array($needle,$needle.'n',$needle.'en',$needle.'s'),true)) { $found=true; break; }
+                }
+                if (!$found) { $matched=false; break; }
+            }
+            if (!$matched) { continue; }
+            // Do not submit entire prose passages as shopping searches.
+            $query=strlen($title)<=110 ? $title : $family;
+            $hash=hash('sha256',$this->hb_amazon_normalize_title($query).'|'.$slug);
+            return array('id'=>$id,'title'=>$query,'family'=>$family,
+                'category_slug'=>$slug,'source'=>'hab_article','hash'=>$hash);
+        }
+        return null;
+    }
+
+    /** Bounded scan; new published posts or changed titles/categories are
+     * discovered at later scheduled runs. Saving a post itself causes NO API call.
+     */
+    private function hb_amazon_article_candidate(&$control) {
+        $offset=max(0,absint($control['article_scan_offset'] ?? 0));
+        $posts=get_posts(array('post_type'=>'post','post_status'=>'publish',
+            'posts_per_page'=>100,'offset'=>$offset,'orderby'=>'ID','order'=>'ASC','suppress_filters'=>true));
+        if (!$posts && $offset>0) {
+            $offset=0;
+            $posts=get_posts(array('post_type'=>'post','post_status'=>'publish',
+                'posts_per_page'=>100,'offset'=>0,'orderby'=>'ID','order'=>'ASC','suppress_filters'=>true));
+        }
+        $control['article_scan_offset']=count((array)$posts)<100?0:$offset+100;
+        $checked=(array)($control['article_checked'] ?? array());
+        $saved=(array)($control['article_products'] ?? array());
+        foreach ((array)$posts as $post) {
+            $candidate=$this->hb_amazon_article_topic($post);
+            if (!$candidate) { continue; }
+            $id=$candidate['id'];$hash=$candidate['hash'];
+            if (($saved[$id]['hash'] ?? '')===$hash &&
+                !empty($saved[$id]['items']) && absint($saved[$id]['at'] ?? 0)>time()-14*DAY_IN_SECONDS) { continue; }
+            if (($checked[$id]['hash'] ?? '')===$hash &&
+                absint($checked[$id]['at'] ?? 0)>time()-7*DAY_IN_SECONDS) { continue; }
+            return $candidate;
+        }
+        return null;
+    }
+
+    /** Article results never promise a feature (e.g. without WLAN) unless the
+     * product title actually states it; generic titles still require the family.
+     */
+    private function hb_amazon_article_results($topic,$items) {
+        $found=$this->hb_amazon_category_results((string)$topic['family'],$items);
+        $article_title=$this->hb_amazon_normalize_title((string)$topic['title']);
+        // The normalized title is sorted, so check individual terms rather than a phrase.
+        $words=explode(' ',$article_title);
+        $family_words=explode(' ',$this->hb_amazon_normalize_title((string)$topic['family']));
+        $stop=array('welche','welcher','welches','wie','was','wer','wann','warum','sind','ist',
+            'eine','einen','einem','einer','oder','aber','welchen','gibt','es','den','das','die',
+            'der','mit','ohne','fuer','bei','von','auf','im','am','in','und','als','zum','zur',
+            'richtig','gut','beste','besten','kaufen','vergleich','test','ratgeber','tipps',
+            'im','haus','wohnung','garten','keller','sichern','schuetzen','installieren');
+        $modifiers=array_values(array_filter($words,static function($w) use ($family_words,$stop) {
+            return strlen($w)>=3 && !in_array($w,$family_words,true) && !in_array($w,$stop,true);
+        }));
+        $has_without=in_array('ohne',$words,true);
+        $negative_terms=array_values(array_intersect($modifiers,array('wlan','bohren','kabel','akku','strom','internet','abo')));
+        if ($has_without && !$negative_terms) { return array(); }
+        return array_values(array_filter($found,function($item) use ($modifiers,$has_without,$negative_terms) {
+            $title=' '.$this->hb_amazon_normalize_title((string)($item['title'] ?? '')).' ';
+            if ($has_without) {
+                if (strpos($title,' ohne ')===false) { return false; }
+                foreach ($negative_terms as $term) { if (strpos($title,' '.$term.' ')===false) { return false; } }
+            }
+            if (!$modifiers) { return true; }
+            $one=false;
+            foreach ($modifiers as $term) {
+                $present=strpos($title,' '.$term.' ')!==false;
+                // Numbers and pack sizes must always agree, not just one other word.
+                if (preg_match('/^[0-9]/',$term) && !$present) { return false; }
+                if ($present) { $one=true; }
+            }
+            return $one;
+        }));
+    }
+
+    /** Only render where the EXISTING Hab article product slot has no valid
+     * provider campaign; do not override the original article plan or adverts.
+     */
+    private function hb_amazon_article_fallback($post_id) {
+        if (!$this->hb_amazon_ready() || !function_exists('get_post')) { return ''; }
+        $topic=$this->hb_amazon_article_topic(get_post(absint($post_id)));
+        if (!$topic) { return ''; }
+        $c=get_option(self::HB_AMAZON_CONTROL,array());
+        $article_products=(array)($c['article_products'] ?? array());
+        $saved=(array)($article_products[$topic['id']] ?? array());
+        $items=(($saved['hash'] ?? '')===$topic['hash'] &&
+            absint($saved['at'] ?? 0)>time()-14*DAY_IN_SECONDS)
+            ? (array)($saved['items'] ?? array()) : array();
+        $parts=array();
+        foreach ($items as $item) {
+            $asin=strtoupper(trim((string)($item['asin'] ?? '')));
+            $url=$this->hb_amazon_direct_url($asin);
+            $title=sanitize_text_field((string)($item['title'] ?? ''));
+            if ($url!=='' && $title!=='') {
+                $parts[]='<a href="'.esc_url($url).'" target="_blank" rel="sponsored nofollow noopener noreferrer">'.esc_html($title).'</a>';
+            }
+        }
+        // No invented product if no API result is available yet.
+        if (!$parts) {
+            $url='https://www.amazon.de/s?k='.rawurlencode($topic['title']).'&tag='.rawurlencode($this->hb_amazon_tag());
+            $parts[]='<a href="'.esc_url($url).'" target="_blank" rel="sponsored nofollow noopener noreferrer">Passende Angebote bei Amazon suchen</a>';
+        }
+        return '<div class="ppar-affiliate-slot ppar-hab-amazon-article" data-ppar-slot="post_bottom_products">'
+            . '<div class="ppar-affiliate-label">Anzeige</div>'
+            . '<div class="ppar-affiliate-content">'.implode(' · ',$parts).'</div></div>';
     }
 
