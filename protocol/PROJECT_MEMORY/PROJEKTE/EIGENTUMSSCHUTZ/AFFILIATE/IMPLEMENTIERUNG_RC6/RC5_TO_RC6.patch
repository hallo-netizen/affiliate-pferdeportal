+    /** The existing portal-source catalog is the only authority for product families. */
+    private function hb_amazon_category_candidate(&$control) {
+        if (!class_exists('PPAR_Portal_Source') || !method_exists('PPAR_Portal_Source','catalog')) { return null; }
+        $catalog=PPAR_Portal_Source::catalog();
+        if (is_wp_error($catalog) || !is_array($catalog)) { return null; }
+        $checked=(array)($control['category_checked'] ?? array());
+        $saved=(array)($control['category_products'] ?? array());
+        foreach ((array)($catalog['product_targets'] ?? array()) as $row) {
+            if (!is_array($row)) { continue; }
+            $slug=sanitize_key((string)($row['category_slug'] ?? ''));
+            $family=sanitize_text_field((string)($row['title'] ?? ''));
+            if ($slug==='' || $family==='' || strlen($family)>90) { continue; }
+            if (!empty($saved[$slug]['items']) && absint($saved[$slug]['at'] ?? 0)>time()-14*DAY_IN_SECONDS) { continue; }
+            if (absint($checked[$slug]['at'] ?? 0)>time()-7*DAY_IN_SECONDS) { continue; }
+            return array('id'=>0,'title'=>$family,'hash'=>hash('sha256',$this->hb_amazon_normalize_title($family)),
+                'category_slug'=>$slug,'source'=>'hab_category');
+        }
+        return null;
+    }
+
+    /** Select only genuine amazon.de organic listings that explicitly name the product family. */
+    private function hb_amazon_category_results($family,$items) {
+        $family_terms=array_values(array_filter(explode(' ',$this->hb_amazon_normalize_title($family))));
+        if (!$family_terms) { return array(); }
+        $result=array();
+        foreach ((array)$items as $item) {
+            if (!is_array($item) || (string)($item['type'] ?? '')!=='amazon_serp') { continue; }
+            $title=sanitize_text_field((string)($item['title'] ?? ''));
+            $url=(string)($item['url'] ?? '');
+            if ($title==='' || strlen($title)>350) { continue; }
+            $host=strtolower((string)wp_parse_url($url, PHP_URL_HOST));
+            if (!in_array($host,array('amazon.de','www.amazon.de'),true)) { continue; }
+            $words=' '.$this->hb_amazon_normalize_title($title).' ';
+            $eligible=true;
+            foreach ($family_terms as $term) { if (strpos($words,' '.$term.' ')===false) { $eligible=false; break; } }
+            if (!$eligible) { continue; }
+            $asin=strtoupper(trim((string)($item['data_asin'] ?? '')));
+            if (!preg_match('/^[A-Z0-9]{10}$/D',$asin)) { continue; }
+            if (isset($result[$asin])) { continue; }
+            // Do not store provider images, prices, ratings or stock claims.
+            $result[$asin]=array('asin'=>$asin,'title'=>function_exists('mb_substr') ? mb_substr($title,0,180) : substr($title,0,180));
+            if (count($result)>=3) { break; }
+        }
+        return array_values($result);
+    }
