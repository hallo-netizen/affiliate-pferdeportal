{
  "contract": "HOBBY_MASTER_V2_ASSESSMENT_RULES",
  "version": "1.1",
  "effective_date": "2026-10-07",
  "status": "ACTIVE_V2_RULESET_LEAF_CAPACITY_AND_AGGREGATION_BOUND",
  "source_master": {
    "revision": "HD-HOBBY-MASTER-V2-20261007",
    "sha256": "a4cae906ce4f9fefcc805b8c83fc746859d508d32f3e2f981f01f6d26f7353b7",
    "canonical_entries": 841,
    "research_queue_entries": 19
  },
  "protected_architecture": {
    "top_worlds": [
      "gestalten",
      "fertigen",
      "technik",
      "forschen",
      "pflanzen",
      "tiere",
      "bewegen",
      "sammeln"
    ],
    "top_worlds_are_core_level_1": true,
    "hobbywelten_is_view_only": true,
    "pillars": [
      "CORE",
      "EDITORIAL",
      "DIRECTORY"
    ],
    "dataforseo_may_define_structure": false
  },
  "output_contract": {
    "portal_roles": [
      "ORIENTATION_UNIVERSE",
      "HOBBY_HUB",
      "EDITORIAL_TOPIC",
      "ARTICLE_ONLY",
      "FINDER_ONLY",
      "OUT_OF_SCOPE"
    ],
    "size_classes": [
      "MICRO",
      "FIT",
      "MACRO"
    ],
    "primary_pillars": [
      "CORE",
      "EDITORIAL",
      "FINDER",
      "NONE"
    ],
    "decision_states": [
      "ASSESSED",
      "PARTIAL",
      "EVIDENCE_REQUIRED",
      "SCOPE_REVIEW",
      "OUT_OF_SCOPE"
    ],
    "rule": "No field may be inferred from monetization or SEO demand alone. Missing required evidence produces EVIDENCE_REQUIRED, never a guessed value."
  },
  "gates": [
    {
      "order": 1,
      "id": "A_SCOPE",
      "required_inputs": [
        "active_repeatable_leisure_practice",
        "teachable_or_practicable_core",
        "natural_world"
      ],
      "rules": [
        {
          "priority": 1,
          "when": {
            "explicit_out_of_scope_evidence": true
          },
          "result": {
            "scope_status": "OUT_OF_SCOPE",
            "decision_state": "OUT_OF_SCOPE"
          }
        },
        {
          "priority": 2,
          "when": {
            "natural_world_not_in_protected_worlds": true
          },
          "result": {
            "scope_status": "SCOPE_REVIEW",
            "decision_state": "SCOPE_REVIEW"
          }
        },
        {
          "priority": 3,
          "when": {
            "all_required_inputs_true": true,
            "natural_world_in_protected_worlds": true
          },
          "result": {
            "scope_status": "IN_SCOPE"
          }
        },
        {
          "priority": 4,
          "when": {
            "master_scope_status": "IN_SCOPE_PROVISIONAL",
            "natural_world_in_protected_worlds": true
          },
          "result": {
            "scope_status": "IN_SCOPE_PROVISIONAL"
          },
          "note": "Legacy evidence may pass the candidate into later gates but does not become final scope evidence by itself."
        },
        {
          "priority": 5,
          "when": {
            "required_input_missing": true
          },
          "result": {
            "scope_status": "UNASSESSED",
            "decision_state": "EVIDENCE_REQUIRED"
          }
        }
      ],
      "hard_rule": "Never invent a ninth world and never force a candidate into an unnatural world."
    },
    {
      "order": 2,
      "id": "B_IDENTITY",
      "required_inputs": [
        "hobby_id_or_research_key",
        "canonical_name",
        "aliases"
      ],
      "rules": [
        {
          "priority": 1,
          "when": {
            "canonical_or_alias_collision_with_existing_identity": true
          },
          "result": {
            "identity_action": "MERGE_OR_ALIAS_REVIEW",
            "new_hobby_id_allowed": false
          }
        },
        {
          "priority": 2,
          "when": {
            "existing_master_identity_unique": true
          },
          "result": {
            "identity_action": "KEEP_STABLE_ID"
          }
        },
        {
          "priority": 3,
          "when": {
            "research_candidate_no_collision": true,
            "scope_status": "IN_SCOPE"
          },
          "result": {
            "identity_action": "NEW_PROVISIONAL_ID_ALLOWED"
          },
          "note": "Create no publishable node; only add a provisional master identity."
        },
        {
          "priority": 4,
          "when": {
            "research_candidate_scope_not_final": true
          },
          "result": {
            "identity_action": "HOLD_IN_RESEARCH_QUEUE"
          }
        }
      ]
    },
    {
      "order": 3,
      "id": "C_CONTENT_CAPACITY",
      "required_inputs": [
        "distinct_intents",
        "viable_leaf_categories",
        "estimated_articles"
      ],
      "leaf_rules": [
        {
          "when": {
            "distinct_intents_max": 3
          },
          "result": "NO_LEAF_CATEGORY"
        },
        {
          "when": {
            "distinct_intents": 4
          },
          "result": "LEAF_EXCEPTION_REVIEW"
        },
        {
          "when": {
            "distinct_intents_min": 5,
            "distinct_intents_max": 12
          },
          "result": "LEAF_FIT"
        },
        {
          "when": {
            "distinct_intents_min": 13,
            "distinct_intents_max": 15
          },
          "result": "LEAF_SPLIT_REVIEW"
        },
        {
          "when": {
            "distinct_intents_min": 16
          },
          "result": "LEAF_SPLIT_REQUIRED"
        }
      ],
      "hub_rules": [
        {
          "when": {
            "viable_leaf_categories_max": 2
          },
          "result": {
            "size_class": "MICRO"
          }
        },
        {
          "when": {
            "viable_leaf_categories_min": 3,
            "viable_leaf_categories_max": 6
          },
          "result": {
            "size_class": "FIT"
          }
        },
        {
          "when": {
            "viable_leaf_categories_min": 7,
            "viable_leaf_categories_max": 8
          },
          "result": {
            "decision_state": "EVIDENCE_REQUIRED",
            "review": "MACRO_OR_SPLIT_REVIEW"
          }
        },
        {
          "when": {
            "viable_leaf_categories_min": 9
          },
          "result": {
            "size_class": "MACRO"
          }
        }
      ],
      "macro_overrides": [
        "more_than_8_durable_leaf_categories",
        "multiple_distinct_activity_identities",
        "would_behave_like_own_portal"
      ],
      "missing_evidence_result": {
        "decision_state": "EVIDENCE_REQUIRED"
      },
      "hard_rule": "Article or leaf counts are counts of distinct user/search intents, not wording variants."
    },
    {
      "order": 4,
      "id": "D_PORTAL_ROLE",
      "rules": [
        {
          "when": {
            "scope_status": "OUT_OF_SCOPE"
          },
          "result": {
            "portal_role": "OUT_OF_SCOPE",
            "primary_pillar": "NONE"
          }
        },
        {
          "when": {
            "scope_status": "IN_SCOPE",
            "size_class": "FIT",
            "viable_leaf_categories_min": 3,
            "viable_leaf_categories_max": 6,
            "ownership_clear": true
          },
          "result": {
            "portal_role": "HOBBY_HUB",
            "primary_pillar": "CORE"
          }
        },
        {
          "when": {
            "scope_status": "IN_SCOPE",
            "size_class": "MACRO",
            "decomposes_into_multiple_hobby_units": true,
            "orientation_page_nonredundant": true,
            "ownership_clear": true
          },
          "result": {
            "portal_role": "ORIENTATION_UNIVERSE",
            "primary_pillar": "CORE"
          }
        },
        {
          "when": {
            "scope_status": "IN_SCOPE",
            "size_class": "MICRO",
            "estimated_articles_min": 5,
            "ownership_clear": true
          },
          "result": {
            "portal_role": "EDITORIAL_TOPIC",
            "primary_pillar": "EDITORIAL"
          }
        },
        {
          "when": {
            "scope_status": "IN_SCOPE",
            "size_class": "MICRO",
            "estimated_articles_min": 1,
            "estimated_articles_max": 4,
            "ownership_clear": true
          },
          "result": {
            "portal_role": "ARTICLE_ONLY",
            "primary_pillar": "EDITORIAL"
          }
        },
        {
          "when": {
            "scope_status": "IN_SCOPE",
            "size_class": "MICRO",
            "estimated_articles": 0
          },
          "result": {
            "portal_role": "FINDER_ONLY",
            "primary_pillar": "FINDER"
          }
        },
        {
          "when": {
            "required_role_input_missing": true
          },
          "result": {
            "decision_state": "EVIDENCE_REQUIRED"
          }
        }
      ],
      "hard_rule": "Monetization cannot create a portal role. HOBBY_HUB requires per-leaf capacity proof; a hobby-wide total is not enough.",
      "hard_requirements": {
        "HOBBY_HUB": [
          "scope_status == IN_SCOPE",
          "semantic_identity_confirmed == true",
          "all_counted_leafs individually satisfy leaf_capacity_contract",
          "fit_leaf_count between 3 and 6",
          "ownership_clear == true"
        ],
        "ORIENTATION_UNIVERSE": [
          "scope_status == IN_SCOPE",
          "semantic_identity_confirmed == true",
          "topic is demonstrably MACRO",
          "decomposes into multiple coherent hobby units",
          "orientation page is nonredundant",
          "ownership_clear == true"
        ]
      }
    },
    {
      "order": 5,
      "id": "E_ECONOMICS",
      "rules": [
        {
          "when": {
            "monetization_fit_in": [
              "DIRECT",
              "ASSISTED"
            ]
          },
          "result": {
            "commercial_priority": "ELIGIBLE_FOR_PROMINENCE"
          }
        },
        {
          "when": {
            "monetization_fit_in": [
              "NONE",
              "UNKNOWN"
            ]
          },
          "result": {
            "commercial_priority": "NO_AUTO_PROMOTION",
            "retention": "KEEP_IF_SCOPE_VALID"
          }
        }
      ]
    },
    {
      "order": 6,
      "id": "F_OWNERSHIP",
      "required_inputs": [
        "primary_intents",
        "existing_owner_map"
      ],
      "rules": [
        {
          "when": {
            "primary_intent_owner_conflict": true
          },
          "result": {
            "decision_state": "EVIDENCE_REQUIRED",
            "publish_allowed": false
          }
        },
        {
          "when": {
            "primary_intent_owner_conflict": false
          },
          "result": {
            "ownership_clear": true
          }
        }
      ],
      "hard_rule": "Exactly one SEO owner per primary intent across CORE, EDITORIAL and DIRECTORY. Other pillars may relate/filter/link only."
    }
  ],
  "research_queue_intake": {
    "counted_in_current_841": false,
    "sequence": [
      "A_SCOPE",
      "B_IDENTITY",
      "C_CONTENT_CAPACITY",
      "D_PORTAL_ROLE",
      "E_ECONOMICS",
      "F_OWNERSHIP"
    ],
    "create_master_identity_only_when": [
      "scope_status == IN_SCOPE",
      "identity_action == NEW_PROVISIONAL_ID_ALLOWED"
    ],
    "provisional_entry_defaults": {
      "retention": "KEEP",
      "assessment_status": "PENDING",
      "monetization_fit": "UNKNOWN",
      "structural_role": "UNASSESSED",
      "publication_role": "UNASSESSED"
    },
    "hard_rule": "expected_world and initial_size_hypothesis are hypotheses only. They may select what to research but may not become final structure without gate evidence."
  },
  "batch_001_selection": {
    "order": "stable and reproducible",
    "steps": [
      "For each protected world in protected_architecture.top_worlds, select lexicographically first hobby_id with scope_status=IN_SCOPE_PROVISIONAL.",
      "Add every current master entry with at least one alias.",
      "Add lexicographically first four hobby_id values with scope_status=UNASSESSED.",
      "Deduplicate by hobby_id preserving first occurrence."
    ],
    "expected_count": 16
  },
  "promotion_gate": {
    "to_assessed": "All required gates for the chosen portal_role have evidence. For HOBBY_HUB, every lowest-level category must be capacity-validated and ownership must be clear.",
    "to_target_tree": "assessment_status=ASSESSED only. PARTIAL, EVIDENCE_REQUIRED and SCOPE_REVIEW never create/alter target-tree nodes."
  },
  "leaf_capacity_contract": {
    "purpose": "A HOBBY_HUB is only structurally viable when its lowest category level itself carries enough distinct article intents.",
    "candidate_generation": "Leaf families and article intents are proposed by subject-matter logic first. DataForSEO may validate demand/intent separation but may not invent the taxonomy.",
    "article_intent_rule": "One counted article = one genuinely distinct user/search intent. Wording variants, synonyms and near-duplicate questions count once.",
    "validation_fields_per_article_intent": [
      "intent_id",
      "working_title",
      "user_need",
      "fachlich_distinct_from",
      "dataforseo_keywords",
      "dataforseo_main_intent",
      "dataforseo_core_keyword",
      "dataforseo_search_volume",
      "strategic_nonseo_reason",
      "validated"
    ],
    "validated_article_rule": "An article intent counts toward leaf capacity only when fachlich distinct AND either backed by DataForSEO intent/keyword evidence OR backed by an explicit strategic_nonseo_reason. Missing evidence does not count.",
    "leaf_thresholds": {
      "4": "LEAF_EXCEPTION_REVIEW",
      "0_3": "NO_STANDALONE_LEAF__AGGREGATE_OR_EDITORIAL",
      "5_12": "LEAF_FIT",
      "13_15": "LEAF_SPLIT_REVIEW",
      "16_plus": "LEAF_SPLIT_REQUIRED"
    },
    "hub_thresholds": {
      "0_2_fit_leafs": "NO_HOBBY_HUB__EDITORIAL_OR_FINDER_REVIEW",
      "3_6_fit_leafs": "HOBBY_HUB_FIT",
      "7_8_fit_leafs": "MACRO_OR_SPLIT_REVIEW",
      "9_plus_fit_leafs": "MACRO_SPLIT_REQUIRED"
    },
    "hard_rule": "A total article count across the whole hobby is insufficient. Every proposed lowest-level category is checked separately."
  },
  "aggregation_contract": {
    "purpose": "Preserve small valid hobbies without creating hundreds of thin taxonomy nodes.",
    "identity_rule": "Canonical hobby identities are never merged merely because they are small. Aggregation concerns presentation/content structure, not hobby identity.",
    "eligible_when": [
      "candidate is IN_SCOPE",
      "candidate does not support a standalone HOBBY_HUB or standalone leaf",
      "related candidates share a natural existing world/topic family",
      "combined content can form a coherent user-facing summary/leaf/editorial cluster",
      "ownership remains unique and cannibalization is controlled"
    ],
    "aggregation_types": [
      "EXISTING_PARENT_SUMMARY",
      "SHARED_LEAF_CATEGORY",
      "EDITORIAL_CLUSTER"
    ],
    "combined_capacity_rule": "A shared lowest-level category must itself satisfy the same 5-12 validated-article target. Under 4 remains too thin; 13+ triggers split review.",
    "example_from_concept": "Small Naturfunde identities such as Treibholz, Seeglas or Muscheln may remain separate identities but be surfaced through a stronger shared Naturfunde summary/editorial structure instead of separate thin hubs.",
    "create_new_structural_group_rule": "Do not create a new intermediate taxonomy node during candidate assessment. Record AGGREGATION_CANDIDATE first; create/alter structure only in the later full target-tree delta after the assessed population proves the need.",
    "dataforseo_role": "Use keyword/core-keyword/intent overlap to test whether candidates belong together or would cannibalize. DataForSEO may not name or create the group."
  },
  "dataforseo_evidence_contract": {
    "provider": "DataForSEO",
    "market": {
      "location_name": "Germany",
      "language_code": "de"
    },
    "existing_client_contract": {
      "keyword_ideas_endpoint": "/v3/dataforseo_labs/google/keyword_ideas/live",
      "keyword_overview_endpoint": "/v3/dataforseo_labs/google/keyword_overview/live",
      "keyword_suggestions_endpoint": "/v3/dataforseo_labs/google/keyword_suggestions/live"
    },
    "workflow": [
      "Subject logic proposes candidate leaf families and distinct article intents.",
      "Run keyword_suggestions/keyword_ideas for the hobby and proposed leaf/article seeds.",
      "Run keyword_overview on the deduplicated candidate keywords.",
      "Use core_keyword, main_intent, synonyms/variants, longtail depth and demand to collapse duplicates and confirm distinct intent space.",
      "Recount validated article intents per leaf.",
      "Apply leaf thresholds and only then hub thresholds."
    ],
    "may_confirm": [
      "primary_keyword",
      "synonyms",
      "search_volume",
      "demand_band",
      "main_intent",
      "core_keyword",
      "longtail_depth",
      "intent_overlap",
      "cannibalization_risk"
    ],
    "may_not_decide": [
      "portal_scope",
      "natural_world",
      "parent",
      "leaf_family_name",
      "structural_role",
      "publication_role",
      "CORE_promotion",
      "deletion"
    ],
    "fail_closed": "Without a real DataForSEO response, SEO validation fields stay PENDING_DFS. No synthetic search volume or keyword evidence may be invented."
  },
  "assessment_sequence_v2": [
    "A_SCOPE",
    "B_IDENTITY",
    "C_PROPOSE_LEAF_AND_ARTICLE_INTENTS",
    "C1_DATAFORSEO_VALIDATE_AND_DEDUP",
    "C2_RECOUNT_EACH_LOWEST_LEVEL_CATEGORY",
    "C3_AGGREGATION_REVIEW_FOR_THIN_VALID_TOPICS",
    "D_PORTAL_ROLE",
    "E_ECONOMICS",
    "F_OWNERSHIP"
  ]
}
