+    private function ebay_audit_export_row($out, $row, $columns, $format) {
+        if ($format === 'json') { fwrite($out,wp_json_encode($row,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)."\n"); return; }
+        $cells = array();
+        foreach ($columns as $key) {
+            $value = $row[$key] ?? '';
+            if (is_array($value)) { $value = wp_json_encode($value,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES); }
+            $value = (string)$value;
+            // Prevent spreadsheet formula injection in downloaded diagnostics.
+            if (preg_match('/^[=+@\-\t\r]/u',$value)) { $value = "'".$value; }
+            $cells[] = $value;
+        }
+        fputcsv($out,$cells,';', '"', '');
+    }
