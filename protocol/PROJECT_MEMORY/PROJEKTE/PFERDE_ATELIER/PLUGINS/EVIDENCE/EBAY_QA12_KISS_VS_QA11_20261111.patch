+    private function ebay_audit_note_state($current, $previous = array(), $kind = 'state', $activity = array()) {
+        $current = is_array($current) ? $current : array();
+        $uuid = sanitize_text_field((string)($current['run_uuid'] ?? ''));
+        if ($uuid === '' || (string)($current['schema'] ?? '') !== '1.0') { return true; }
+        $event = $this->ebay_audit_snapshot($current, $kind);
+        $previous = is_array($previous) ? $previous : array();
+        // Compact audit: record changed per-item errors, not the same last 30
+        // offers in every one of hundreds of later worker snapshots.
+        $old_skips = absint($previous['skipped_item_errors_count'] ?? 0);
+        $new_skips = absint($current['skipped_item_errors_count'] ?? 0);
+        if ($new_skips <= $old_skips) { $event['skipped_item_examples'] = array(); }
+        else {
+            $delta = $new_skips - $old_skips;
+            $event['skipped_item_examples'] = array_slice((array)$event['skipped_item_examples'], -min(30,$delta));
+            if ($delta > 30) { $event['skipped_item_overflow'] = $delta - 30; }
+        }
+        $old_sources = absint($previous['public_source_refresh']['provider_errors'] ?? 0);
+        $new_sources = absint($current['public_source_refresh']['provider_errors'] ?? 0);
+        if ($new_sources <= $old_sources) { $event['source_error_examples'] = array(); }
+        if ($new_sources > $old_sources) {
+            // New per-tick errors are separately persisted (including beyond
+            // the earlier 12-item state sample cap). For an upgraded existing
+            // run that has no tick-only fields yet, preserve the old samples.
+            $event['source_error_examples'] = empty($event['source_errors_this_tick'])
+                ? array_slice((array)$this->ebay_audit_snapshot($current,$kind)['source_error_examples'],-min(12,$new_sources-$old_sources))
+                : array();
+        }
+        $old_summary = (array)($previous['phase_state']['discovery']['summary'] ?? array());
+        $new_summary = (array)($current['phase_state']['discovery']['summary'] ?? array());
+        if (serialize(array($old_summary['hard_reasons']??array(),$old_summary['review_reasons']??array(),$old_summary['technical_reasons']??array()))
+            === serialize(array($new_summary['hard_reasons']??array(),$new_summary['review_reasons']??array(),$new_summary['technical_reasons']??array()))) {
+            $event['search_rejection_reasons'] = array();
+        }
+        if (is_array($activity) && $activity) { $event['activity'] = $activity; }
+        $key = $this->ebay_audit_key($uuid);
+        $meta_key = $key . '_meta';
+        $meta = get_option($meta_key, array());
+        $meta = is_array($meta) ? $meta : array();
+        if (absint($meta['count'] ?? 0) === 0) {
+            // First observed snapshot of an existing run. Label this as a
+            // snapshot, not an invented complete history before installation.
+            $event['source_error_examples'] = array_slice((array)$this->ebay_audit_snapshot($current, $kind)['source_error_examples'], -12);
+            $event['skipped_item_examples'] = array_slice((array)$this->ebay_audit_snapshot($current, $kind)['skipped_item_examples'], -30);
+            $event['kind'] = $kind === 'state' ? 'first_observed_snapshot' : $kind;
+        }
+        // Skip identical state saves. The timestamp is not a change in the run.
+        $signature_payload = $event;
+        if ($signature_payload['kind']==='first_observed_snapshot') { $signature_payload['kind'] = $kind; }
+        unset($signature_payload['at'], $signature_payload['source_error_examples'], $signature_payload['skipped_item_examples'], $signature_payload['search_rejection_reasons'], $signature_payload['source_errors_this_tick']);
+        $signature = hash('sha256', wp_json_encode($signature_payload));
+        if (hash_equals((string)($meta['last_signature'] ?? ''), $signature)) { return true; }
+        $count = absint($meta['count'] ?? 0);
+        $chunk_no = (int)floor($count / 100);
+        $chunk_key = $key . '_c' . $chunk_no;
+        $rows = get_option($chunk_key, array());
+        $rows = is_array($rows) ? $rows : array();
+        $event['event_number'] = $count + 1;
+        $at_index = $count % 100;
+        if (isset($rows[$at_index])) {
+            // Recovery after a chunk write succeeded but meta write failed.
+            // Never silently replace an earlier event.
+            if (!is_array($rows[$at_index]) ||
+                absint($rows[$at_index]['event_number'] ?? 0) !== $count + 1) { return false; }
+            $old = $rows[$at_index];
+            unset($old['at'],$old['event_number']);
+            $new = $event;
+            unset($new['at'],$new['event_number']);
+            if (serialize($old) !== serialize($new)) { return false; }
+        } else {
+            $rows[] = $event;
+        }
+        if (count($rows) > 100) { return false; } // never overwrite previous chunk
+        update_option($chunk_key, $rows, false);
+        if (serialize(get_option($chunk_key, array())) !== serialize($rows)) { return false; }
+        $new_meta = array('run_uuid'=>$uuid,'count'=>$count+1,'last_signature'=>$signature,
+            'updated_at'=>time(),'last_status'=>$event['status'],'last_phase'=>$event['phase']);
+        update_option($meta_key, $new_meta, false);
+        if (serialize(get_option($meta_key, array())) !== serialize($new_meta)) { return false; }
+        if ($count === 0) {
+            $index = get_option('ppar_ebay_audit_run_index_v1', array());
+            $index = is_array($index) ? $index : array();
+            if (!in_array($uuid, $index, true)) { $index[] = $uuid; }
+            update_option('ppar_ebay_audit_run_index_v1', $index, false);
+            if (!in_array($uuid, (array)get_option('ppar_ebay_audit_run_index_v1',array()), true)) { return false; }
+        }
+        return true;
+    }
