+    /** Validate an explicit horse-question title BEFORE a source-family match.
+     *  Reuses the two existing hard title gates (FAQ + Journal) but gives no type,
+     *  category or production authority; a later resolved lane must still pass
+     *  its own unchanged title/intent checks. Nonquestions remain for the existing
+     *  title-candidate or Sandbox process; no invented question or topic.
+     */
+    private static function validatedTitleBeforeFamilyAssignment(array $base,string $raw,array $registry,string $storedTitle): array {
+        if((string)($base['portal_relevance']??'')!=='PROVEN'||!PSTE_Normalizer::isQuestion($raw))return $base;
+        // The title checks need an ACTUAL word from the original question.
+        // Reuse only the already verified portal-context tokens produced by
+        // worker 1 (e.g. Reitplatz, Longieren, Stute). An old DataForSEO family
+        // or an invented parent/category must never supply the subject.
+        $scope=(array)($base['portal_relevance_gate']['context_evidence']['matched_terms']??[]);
+        $subject='';$subjectLength=0;
+        foreach((preg_split('/[^\p{L}\p{N}-]+/u',$raw)?:[]) as $word){
+            $word=(string)$word;if($word==='')continue;
+            foreach(PSTE_Family_Identity_V2::tokens($word,false) as $token){
+                foreach($scope as $seed){
+                    $seed=(string)$seed;
+                    if(strlen($seed)<4||!(($token===$seed)||(str_starts_with((string)$token,$seed))))continue;
+                    if(strlen($word)>$subjectLength){$subject=$word;$subjectLength=strlen($word);}
+                }
+            }
+        }
+        if($subject==='')return $base;
+        $title=$storedTitle!==''?$storedTitle:PSTE_Normalizer::canonicalQuestion($raw);
+        $targetKeyword=rtrim($title," ?\t\n\r\0\x0B");
+        if($title===''||$targetKeyword==='')return $base;
+        $checked=[];
+        foreach(['FAQ','Journal'] as $type){
+            $intent=['contract'=>'PSTE_INTENT_PROFILE_V4_EVIDENCE_BOUND','ok'=>true,'status'=>'PASS',
+                'search_intent'=>'EDITORIAL_INFORMATION','primary_user_goal'=>'EDITORIAL_INFORMATION',
+                'primary_article_type_candidate'=>$type,'intent_angle'=>'EDITORIAL_INFORMATION',
+                'evidence_authority'=>'TITLE_ONLY_UNASSIGNED','scope_status'=>'UNPROVEN',
+                'intent_status'=>'UNPROVEN','raw_query_sha256'=>hash('sha256',$raw),'write_attempted'=>false];
+            $intent['profile_sha256']=hash('sha256',self::clean(json_encode($intent,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)));
+            $check=PSTE_Title_Pipeline::validateExistingTitle($title,$raw,$subject,$type,$registry,$intent,$targetKeyword,$targetKeyword);
+            if(empty($check['ok']))return $base;
+            $checked[$type]=$check;
+        }
+        $base['title']=$title;$base['title_generated']=true;
+        // This is verified TITLE evidence, but not a publishable production title
+        // until the genuine normal lane/type/category chain independently passes.
+        $base['title_candidate_only']=true;$base['title_precheck_validated']=true;
+        $base['title_candidate_source']='FOUR_STEPS_TITLE_VALIDATED_LANE_PENDING';
+        $base['title_candidate_source_sha256']=hash('sha256',$title);
+        $base['title_pipeline']=$checked['FAQ'];$base['target_keyword']=$targetKeyword;
+        return $base;
+    }
