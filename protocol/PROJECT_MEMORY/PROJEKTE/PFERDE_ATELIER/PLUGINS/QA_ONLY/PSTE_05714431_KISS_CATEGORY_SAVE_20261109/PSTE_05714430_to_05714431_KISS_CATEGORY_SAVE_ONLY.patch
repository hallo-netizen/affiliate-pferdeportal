+            if($id<=0||$name==='')continue;
+            $path=trim((string)($cat['full_path']??''));
+            $label=$name.($path!==''&&$path!==$name?' — '.$path:'').' [#'.$id.']';
+            if(isset($choices[$id]))throw new RuntimeException('PSTE_REVIEW_DUPLICATE_CATEGORY_ID');
+            $choices[$id]=['label'=>$label,'area'=>'FACH'];
