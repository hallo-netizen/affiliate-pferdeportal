+                    if(isset($choices[$id]))throw new RuntimeException('PSTE_REVIEW_CATEGORY_AREA_COLLISION');
+                    $choices[$id]=['label'=>$name.' — Magazin [#'.$id.']','area'=>'MAGAZIN'];
