+    /**
+     * Part of the SAME original category decision, not a second category/SEO check.
+     * A product family is accepted only when EVERY meaningful family word is
+     * present in the unchanged original query, and exactly one family qualifies.
+     * Broad words such as "Pferd" alone never claim a subcategory.
+     */
+    private static function singleOwnerUniqueFamilyFromExistingCatalogue(string $raw,array $registry): array {
+        if(!class_exists('PSTE_Token_Equivalence'))return ['status'=>'UNRESOLVED'];
+        $query=array_fill_keys(PSTE_Token_Equivalence::tokens($raw),true);
+        $generic=array_fill_keys(['pferd','pferde','pferdes','pferdeweid','weid',
+            'artikel','ratgeb','wissen','allgemein','zubehoer','zugeh','produkt'],true);
+        $matches=[];
+        foreach((array)($registry['families']??[]) as $key=>$row){
+            $words=PSTE_Token_Equivalence::tokens((string)($row['topic_family_name']??''));
+            $words=array_values(array_filter($words,static fn($word)=>!isset($generic[$word])));
+            if(!$words)continue;
+            $matched=true;
+            foreach($words as $word){
+                // Exact original equivalence stems, no substring guess:
+                // "Gamaschen" must not become "Magnetfelddecken".
+                if(!isset($query[$word])){$matched=false;break;}
+            }
+            if($matched)$matches[]=(string)$key;
+        }
+        return count($matches)===1?['status'=>'UNIQUE','family_key'=>$matches[0]]:
+            ['status'=>count($matches)>1?'AMBIGUOUS':'NO_MATCH','family_key'=>''];
+    }
