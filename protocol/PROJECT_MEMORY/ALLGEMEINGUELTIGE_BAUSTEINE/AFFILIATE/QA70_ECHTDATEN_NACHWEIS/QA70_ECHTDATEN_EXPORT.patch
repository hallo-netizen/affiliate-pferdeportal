+    /** QA70: read-only admin export of EXISTING persisted eBay decision inputs.
+     * No remote getItem requests, no data update or WP-Cron. Historical HTTP
+     * replies cannot be reconstructed if they were never persisted.
+     */
+    private function ebay_evidence_export_read_only($requested_uuid) {
+        if (!current_user_can('manage_options')) { wp_die('Keine Berechtigung.',403); }
+        $run = $this->ebay_run_load();
+        $uuid = (string)($run['run_uuid'] ?? '');
