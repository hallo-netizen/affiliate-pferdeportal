+    /** Only allow safe source facts into a private user-initiated export.
+     * Never copy API credentials, HTTP authentication or customer addresses. */
+    private function ebay_evidence_redact($value,$depth=0){
+        if($depth>24){return '[NESTING_LIMIT]';}
+        if(!is_array($value)){return is_object($value)?'[OBJECT]':$value;}
+        $out=array();
+        foreach($value as $key=>$data){
+            $label=strtolower((string)$key);
+            if($label==='tracking_url' || $label==='affiliate_url' || preg_match('/(?:secret|password|passphrase|token|authorization|cookie|credential|api_key|api[-_]?key|client_id|access_key|refresh_key|email|phone|buyer|customer|postal|address|seller_username)/i',$label)){
+                $out[$key]='[REDACTED]';continue;
+            }
+            $out[$key]=$this->ebay_evidence_redact($data,$depth+1);
+        }
+        return $out;
+    }
+
+    private function ebay_evidence_emit($out,$kind,$data){
+        fwrite($out,wp_json_encode(array('kind'=>$kind,'data'=>$this->ebay_evidence_redact($data)),
+            JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_INVALID_UTF8_SUBSTITUTE)."\n");
+    }
+
