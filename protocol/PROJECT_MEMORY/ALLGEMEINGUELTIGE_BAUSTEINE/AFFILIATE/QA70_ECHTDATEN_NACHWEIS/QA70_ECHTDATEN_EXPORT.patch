+        }
+        // Actual WordPress public post state for every checkpoint/output campaign.
+        $counts['post']=0;
+        foreach(array_chunk(array_keys($post_ids),200) as $ids){
+            $marks=implode(',',array_fill(0,count($ids),'%d'));
+            $sql=$wpdb->prepare("SELECT ID,post_type,post_status,post_title,post_name,post_modified_gmt FROM {$wpdb->posts} WHERE ID IN ({$marks})",...$ids);
+            $rows=$wpdb->get_results($sql,ARRAY_A);
+            if(!is_array($rows) || (string)($wpdb->last_error ?? '') !== ''){$errors[]='posts_database_read_failed';break;}
+            foreach($rows as $row){$this->ebay_evidence_emit($out,'post',$row);$counts['post']++;}
+        }
+        // A post can be missing; this is a fact the replay must be able to detect.
+        $counts['referenced_post_ids']=count($post_ids);
+        $after=$this->ebay_run_load();$check_after=$this->ebay_public_checkpoint_load();
+        $run_stable=hash_equals($run_before,hash('sha256',serialize($after)));
+        $checkpoint_stable=hash_equals($checkpoint_before,hash('sha256',serialize($check_after)));
+        if(!$run_stable || !$checkpoint_stable){$errors[]='snapshot_changed_during_export';}
+        $this->ebay_evidence_emit($out,'end',array(
+            'run_uuid'=>$uuid,'counts'=>$counts,'read_errors'=>$errors,
+            'run_unchanged_during_export'=>$run_stable,
+            'checkpoint_unchanged_during_export'=>$checkpoint_stable,
+            'snapshot_complete'=>empty($errors),
+            'original_ebay_http_responses_recoverable'=>false,
+            'full_one_to_one_live_acceptance'=>false));
+        fclose($out);
+        exit;
+    }
