+            'source'=>'read_only_wordpress_persisted_data',
+            'historical_http_answers_included'=>false,
+            'read_only'=>true));
+        $this->ebay_evidence_emit($out,'run_state',$run);
+        $this->ebay_evidence_emit($out,'public_checkpoint',$checkpoint);
+        $settings=$this->ebay_settings();
+        $this->ebay_evidence_emit($out,'settings_contract',array(
+            'marketplace_id'=>$settings['marketplace_id'] ?? '',
+            'business_enabled'=>!empty($settings['business_enabled']),
+            'catalog_verified_sha256'=>$settings['catalog_verified_sha256'] ?? '',
+            'rules'=>$settings['rules'] ?? array()));
+        // Bundled canonical target catalogue is part of this very plugin, not a second rule engine.
+        $catalog = $this->ebay_portal_catalog();
+        if (!is_wp_error($catalog)) {
+            $this->ebay_evidence_emit($out,'catalog',array(
+                'source_sha256'=>$catalog['source_sha256'] ?? '',
+                'counts'=>$catalog['counts'] ?? array(),
+                'business_concepts'=>$catalog['business_concepts'] ?? array(),
+                'business_hub_concepts'=>$catalog['business_hub_concepts'] ?? array(),
+                'search_rules'=>$catalog['search_rules'] ?? array()));
+        }
+        $errors=array();$counts=array();$post_ids=array();
+        $specs=array(
+            array('item','ebay_items_table',"seller_account_type='BUSINESS'",
+                'id,item_id,legacy_item_id,seller_account_type,rule_id,target_term_id,listing_post_id,creative_identity_hash,title,short_description,condition_text,price_value,currency,shipping_value,item_web_url,image_url,item_end_at,source_hash,source_payload,status,source_state,policy_state,route_state,output_state,policy_version,classifier_version,source_checked_at,rejection_reason,last_seen,fresh_until,created_at,updated_at'),
+            array('output','output_objects_table',"provider='ebay'",
+                'id,object_key,portal_key,creative_identity_hash,provider,partner_external_id,output_type,target_type,target_key,target_label,slot_id,status,confidence,decision_source,decision_reason,campaign_post_id,listing_post_id,tracking_url,image_url,image_width,image_height,image_hash,source_fingerprint,payload,last_verified,created_at,updated_at'),
+            array('creative','creative_library_table',"provider='ebay'",
+                'id,provider,external_id,identity_hash,creative_type,title,description,tags,image_url,width,height,source_status,source_kind,availability_state,missing_count,last_complete_run,review_status,selected,content_scope,scope_source,classified_at,topic_status,topic_score,topic_targets,source_hash,payload,first_seen,last_seen'),
+            array('manual_decision','output_portal_decisions_table',
+                "creative_identity_hash IN (SELECT identity_hash FROM {$this->creative_library_table()} WHERE provider='ebay')",
+                'id,portal_key,creative_identity_hash,manual_status,reason,created_at,updated_at'),
+        );
+        foreach($specs as $spec){
+            list($kind,$method,$condition,$columns)=$spec;
+            $table=$this->$method(); $last=0; $counts[$kind]=0;
+            // ID-cursor streaming avoids loading the whole catalogue into memory.
+            for($batch=0;$batch<250;$batch++){
+                $sql=$wpdb->prepare("SELECT {$columns} FROM {$table} WHERE {$condition} AND id>%d ORDER BY id ASC LIMIT 200",$last);
+                $rows=$wpdb->get_results($sql,ARRAY_A);
+                if(!is_array($rows) || (string)($wpdb->last_error ?? '') !== ''){
+                    $errors[]=$kind.'_database_read_failed';break;
+                }
+                if(!$rows){break;}
+                foreach($rows as $row){
+                    if(absint($row['id']??0)<=$last){$errors[]=$kind.'_cursor_invariant_failed';break 2;}
+                    $last=absint($row['id']);
+                    foreach(array('source_payload','payload','topic_targets') as $field){
+                        if(!isset($row[$field]) || !is_string($row[$field])){continue;}
