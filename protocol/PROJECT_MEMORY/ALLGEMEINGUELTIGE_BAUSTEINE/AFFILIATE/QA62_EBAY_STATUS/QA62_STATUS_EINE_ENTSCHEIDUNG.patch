+    /** One authoritative decision from the saved canonical run, shared by
+     * admission and the outward heartbeat response. This method performs NO
+     * work, never changes a source record and never starts another worker.
+     * An incoherent saved run is NOT an empty run: fail closed without resetting
+     * the saved UUID, cursor, public checkpoint or previously valid products. */
+    private function ebay_external_tick_saved_run_state($run) {
+        $run=is_array($run)?$run:array();
+        if (!$run) { return 'empty'; }
+        if ((string)($run['schema']??'')!=='1.0') { return 'inconsistent'; }
+        $status=sanitize_key((string)($run['status']??''));
+        $phase=sanitize_key((string)($run['phase']??''));
+        // Reuse the established canonical active predicate. There must never
+        // be a separate competing definition of an active workflow.
+        if ($this->ebay_run_is_active($run)) {
+            return $status==='paused'
+                && sanitize_key((string)($run['resume_reason']??''))==='operator_stop'
+                ? 'operator_paused' : 'active';
+        }
+        if ($status==='completed' && $phase==='completed') { return 'completed'; }
+        if ($status==='failed' && $phase==='failed') { return 'failed'; }
+        // Older completed local check snapshots are recognized as terminal.
+        if ($status==='local_checked' && !in_array($phase,array('completed','failed'),true)) { return 'completed'; }
+        return 'inconsistent';
+    }
+
+    /** Read-only transport status. Never vetoes a valid winner, ranks products,
+     * evaluates coverage or performs any second editorial decision. */
+    private function ebay_external_tick_run_context($run) {
+        $run=is_array($run)?$run:array();
+        return array(
+            'run_status'=>sanitize_key((string)($run['status']??'idle')),
+            'phase'=>sanitize_key((string)($run['phase']??'idle')),
+            'run_uuid'=>sanitize_text_field((string)($run['run_uuid']??'')),
+            'plugin_version'=>self::VERSION,
+        );
+    }
