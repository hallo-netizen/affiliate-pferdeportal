                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "d73d59c306b20f11819eb5c40584a8b562ece85ba20bf4626ce7704d9b9b9e7f",
                  "fact_id": "FACT-HEUTASCHE-001",
                  "locator": "Quick facts / Benefits of hay nets, lines 244-250 and 291-302",
                  "source_id": "SRC-UMN-HAYNET-20261001",
                  "statement": "Kleine und mittlere Öffnungen in Slow-Feed-Heunetzen können bei erwachsenen Pferden die Raufutteraufnahme verlangsamen und die Fresszeit verlängern.",
                  "subject_scope": "Maschenweite und Fressdauer",
                  "time_scope": "allgemeine Produktauswahl"
                },
                {
                  "article_types": [
                    "Beratung"
                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "3f6b2611f3f48e223ec9676c1a8e5ad4f090a4f26d7d598b1e0386946712c6f0",
                  "fact_id": "FACT-HEUTASCHE-002",
                  "locator": "Testing hay nets / feeding rates, lines 265-289",
                  "source_id": "SRC-UMN-HAYNET-20261001",
                  "statement": "In der Untersuchung der University of Minnesota lagen die Öffnungen der getesteten Netze bei 6 Zoll, 1,75 Zoll und 1,0 Zoll; mit kleineren Öffnungen sank die gemessene Fressrate.",
                  "subject_scope": "Maschenweite und Fressrate",
                  "time_scope": "allgemeine Produktauswahl"
                },
                {
                  "article_types": [
                    "Beratung"
                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "d65e5ed644df0c1ff5898af330b1d1053cd49cbbfdf55d8a5c692770f56056b4",
                  "fact_id": "FACT-HEUTASCHE-003",
                  "locator": "Benefits of hay nets, lines 289-302",
                  "source_id": "SRC-UMN-HAYNET-20261001",
                  "statement": "In einer zweiten Untersuchung dauerte eine Heumahlzeit mit dem mittelgroßen Netz etwas mehr als fünf Stunden und mit dem kleinen Netz 6,5 Stunden; bei Kontrolle und großem Netz waren es 3,2 beziehungsweise 3,4 Stunden.",
                  "subject_scope": "Fressdauer nach Netzgröße",
                  "time_scope": "allgemeine Produktauswahl"
                },
                {
                  "article_types": [
                    "Beratung"
                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "d02011f3988c47d4bdb8a4a440e266615efd6ccd761e3bf5e0b6a8ec3a86926d",
                  "fact_id": "FACT-HEUTASCHE-004",
                  "locator": "Types of Slow Feeders, lines 154-158",
                  "source_id": "SRC-UCONN-SLOWFEEDERS-20261001",
                  "statement": "Slow Feeder für Pferde gibt es unter anderem als Netze mit kleineren Öffnungen, als Webbing-Mesh-Konstruktionen und als feste Futterbehälter; die Bauform beeinflusst damit Handhabung und Fresszugang.",
                  "subject_scope": "Bauform und Einsatz",
                  "time_scope": "allgemeine Produktauswahl"
                },
                {
                  "article_types": [
                    "Beratung"
                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "2fb7f0e6cd38dd47f290849e978798d12279ad3732efce9bb3cddec2eb963f18",
                  "fact_id": "FACT-HEUTASCHE-005",
                  "locator": "Pros and Cons, lines 159-165",
                  "source_id": "SRC-UCONN-SLOWFEEDERS-20261001",
                  "statement": "Bei bodennah eingesetzten weichen Slow-Feedern muss die Hufsicherheit berücksichtigt werden, weil sich beschlagene Pferde mit einem Hufeisen im Material verfangen können.",
                  "subject_scope": "Hufsicherheit und Beschlag",
                  "time_scope": "allgemeine Produktauswahl"
                },
                {
                  "article_types": [
                    "Beratung"
                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "6525466b712afd337052544305d31785c0b683dc306ce547d8aceccababa28df",
                  "fact_id": "FACT-HEUTASCHE-006",
                  "locator": "Pros and Cons, lines 163-173",
                  "source_id": "SRC-UCONN-SLOWFEEDERS-20261001",
                  "statement": "Webbing-Slow-Feeder sind oft leicht zu befüllen, können aber einen schnelleren Heuzugang ermöglichen; höheres Aufhängen kann den Zugang bremsen, verändert jedoch die Kopf- und Halsposition beim Fressen.",
                  "subject_scope": "Befüllung, Aufhängung und Fresshaltung",
                  "time_scope": "allgemeine Produktauswahl"
                },
                {
                  "article_types": [
                    "Beratung"
                  ],
                  "claim_status": "FULLY_SUPPORTED",
                  "evidence_text_sha256": "3e7ae76df27e2f98ae449143d585f2b4e08781c2dca210aa453fe4bddb907dc3",
                  "fact_id": "FACT-HEUTASCHE-007",
                  "locator": "Five Safety Risks To Consider",
