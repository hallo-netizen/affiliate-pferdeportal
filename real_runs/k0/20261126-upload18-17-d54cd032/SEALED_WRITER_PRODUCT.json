{
  "contract": "K0_ARTICLE_PACKAGE_V1",
  "identity": {
    "title": "Kosten der Allianz Pferde OP Versicherung",
    "target_keyword": "allianz pferde op versicherung kosten",
    "category": "pferde-op-versicherung-tarife-und-kosten",
