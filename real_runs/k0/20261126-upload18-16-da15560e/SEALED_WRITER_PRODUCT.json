{
  "contract": "K0_ARTICLE_PACKAGE_V1",
  "identity": {
    "title": "Anbieter von Pferdekrankenversicherungen vergleichen",
    "target_keyword": "pferdekrankenversicherung anbieter",
    "category": "pferdekrankenversicherung-vergleich",
