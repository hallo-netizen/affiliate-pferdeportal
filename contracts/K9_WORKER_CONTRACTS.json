{
  "contract": "K9_WORKER_CONTRACTS_V1",
  "concept": "K9",
  "cross_station_chaining": false,
  "contracts": {
    "research": {
      "worker_type": "CHAT_RESEARCH_WORKER",
      "input_rule": "USE_ONLY_THIS_JOB_ITEM_BOUND_PORTAL_CONTEXT_AND_PUBLIC_RESEARCH_SOURCES",
      "output_contract": "K9_RESEARCH_PRODUCT_V1",
      "must": [
        "RETURN_ONE_COMPLETE_RESULT_PER_ITEM",
        "USE_STABLE_SOURCE_IDS",
        "USE_STABLE_FACT_IDS",
        "BIND_EVERY_FACT_TO_ONE_KNOWN_SOURCE",
        "RETURN_PPM_COMPATIBLE_FACT_PACK",
        "FACT_PACK_STATUS_SOURCE_VERIFIED_PRODUCTION_READY",
        "HASH_COMPLETE_RESEARCH_PRODUCT",
        "EXECUTE_EXACT_OPEN_STATION_ONLY",
        "TREAT_BOUND_PREDECESSOR_PRODUCTS_AS_AUTHORITATIVE_INPUT",
        "IF_UNEXECUTABLE_RETURN_ONLY_CONCRETE_INPUT_BLOCKER",
        "COPY_BOUND_PORTAL_LINKS_EXACTLY",
        "RETURN_DECISION_SUPPORT_WITH_GOAL_AND_CRITERIA"
      ],
      "forbidden": [
        "WRITE_ARTICLE",
        "ROUTE_TO_WRITE",
        "USE_PFERDE_ATELIER_OWN_DOMAIN_AS_RESEARCH_SOURCE",
        "RETURN_PARTIAL_BATCH",
        "USE_ANY_STATE_OUTSIDE_THIS_EXACT_JOB",
        "REOPEN_OR_REEVALUATE_ACCEPTED_PREDECESSOR_STATION",
        "CHANGE_WORKFLOW_OR_ARCHITECTURE",
        "CHANGE_QUALITY_GATES",
        "RESET_OR_REPLACE_TEST_STATE",
        "CREATE_ALTERNATIVE_ROUTE_OR_FALLBACK",
        "PERFORM_SUPERVISOR_OR_SYSTEM_FIXES",
        "DISCUSS_OR_SELECT_OTHER_CONCEPT_VERSIONS",
        "INVENT_OR_CHANGE_PORTAL_LINKS"
      ],
      "required_output_fields": [
        "sources",
        "portal_links",
        "decision_support",
        "fact_pack",
        "product_sha256"
      ],
      "output_field_sources": {
        "sources": "PUBLIC_RESEARCH_SOURCES",
        "portal_links": "COPY_EXACTLY_FROM_JOB_INPUT_PRODUCTS_PORTAL_CONTEXT_PORTAL_LINKS",
        "decision_support": "DERIVE_FROM_VERIFIED_RESEARCH_FOR_THE_BOUND_ARTICLE_TYPE_AND_TOPIC",
        "fact_pack": "VERIFIED_RESEARCH_FACTS_ONLY",
        "product_sha256": "HASH_COMPLETE_RESEARCH_PRODUCT_WITHOUT_PRODUCT_SHA256_FIELD"
      }
    },
    "write": {
      "worker_type": "CHAT_WRITE_WORKER",
      "input_rule": "USE_ONLY_THE_SEALED_RESEARCH_PRODUCT_IN_THIS_JOB",
      "output_contract": "K9_ARTICLE_PRODUCT_V1",
      "must": [
        "RETURN_ONE_COMPLETE_RESULT_PER_ITEM",
        "USE_ONLY_FACTS_FROM_BOUND_RESEARCH_PRODUCT",
        "RETURN_FINAL_ARTICLE_HTML",
        "BIND_RESEARCH_PRODUCT_SHA256",
        "RETURN_PPM_ITEM_BOUND_TO_SAME_FACT_PACK",
        "HASH_COMPLETE_ARTICLE_PRODUCT",
        "EXECUTE_EXACT_OPEN_STATION_ONLY",
        "TREAT_BOUND_PREDECESSOR_PRODUCTS_AS_AUTHORITATIVE_INPUT",
        "IF_UNEXECUTABLE_RETURN_ONLY_CONCRETE_INPUT_BLOCKER"
      ],
      "forbidden": [
        "DO_NEW_RESEARCH",
        "INVENT_NEW_FACTS",
        "ROUTE_TO_CHECK",
        "RETURN_PARTIAL_BATCH",
        "USE_ANY_STATE_OUTSIDE_THIS_EXACT_JOB",
        "REOPEN_OR_REEVALUATE_ACCEPTED_PREDECESSOR_STATION",
        "CHANGE_WORKFLOW_OR_ARCHITECTURE",
        "CHANGE_QUALITY_GATES",
        "RESET_OR_REPLACE_TEST_STATE",
        "CREATE_ALTERNATIVE_ROUTE_OR_FALLBACK",
        "PERFORM_SUPERVISOR_OR_SYSTEM_FIXES",
        "DISCUSS_OR_SELECT_OTHER_CONCEPT_VERSIONS"
      ]
    },
    "check": {
      "worker_type": "K9_NATIVE_MACHINE_CHECK",
      "input_rule": "USE_ONLY_BOUND_RESEARCH_AND_ARTICLE_PRODUCTS",
      "output_contract": "K9_SUBMISSION_V1_WITH_LT68_AND_PPM679_RESULTS",
      "must": [
        "RUN_HASH_BOUND_LANGUAGETOOL_6_8",
        "RUN_HASH_BOUND_PPM_6_7_9",
        "BIND_BOTH_RESULTS_TO_EXACT_ARTICLE_SHA256",
        "RETURN_PASS_OR_REPAIR_REQUIRED",
        "EXECUTE_EXACT_OPEN_STATION_ONLY",
        "TREAT_BOUND_PREDECESSOR_PRODUCTS_AS_AUTHORITATIVE_INPUT",
        "IF_UNEXECUTABLE_RETURN_ONLY_CONCRETE_INPUT_BLOCKER"
      ],
      "forbidden": [
        "MANUAL_PASS_BOOLEAN",
        "CHANGE_ARTICLE",
        "ROUTE_AROUND_FAILED_CHECK",
        "USE_ANY_STATE_OUTSIDE_THIS_EXACT_JOB",
        "REOPEN_OR_REEVALUATE_ACCEPTED_PREDECESSOR_STATION",
        "CHANGE_WORKFLOW_OR_ARCHITECTURE",
        "CHANGE_QUALITY_GATES",
        "RESET_OR_REPLACE_TEST_STATE",
        "CREATE_ALTERNATIVE_ROUTE_OR_FALLBACK",
        "PERFORM_SUPERVISOR_OR_SYSTEM_FIXES",
        "DISCUSS_OR_SELECT_OTHER_CONCEPT_VERSIONS"
      ]
    },
    "repair": {
      "worker_type": "CHAT_REPAIR_WORKER",
      "input_rule": "USE_ONLY_BOUND_RESEARCH_ARTICLE_AND_FAILED_CHECK",
      "output_contract": "K9_ARTICLE_PRODUCT_V1",
      "must": [
        "REPAIR_ONLY_REPORTED_FAILURES",
        "PRESERVE_RESEARCH_PRODUCT_BINDING",
        "RETURN_COMPLETE_REPAIRED_ARTICLE_PRODUCT",
        "HASH_COMPLETE_ARTICLE_PRODUCT",
        "EXECUTE_EXACT_OPEN_STATION_ONLY",
        "TREAT_BOUND_PREDECESSOR_PRODUCTS_AS_AUTHORITATIVE_INPUT",
        "IF_UNEXECUTABLE_RETURN_ONLY_CONCRETE_INPUT_BLOCKER"
      ],
      "forbidden": [
        "DO_NEW_RESEARCH",
        "ADD_UNBOUND_FACTS",
        "ROUTE_TO_CHECK",
        "RETURN_PARTIAL_BATCH",
        "USE_ANY_STATE_OUTSIDE_THIS_EXACT_JOB",
        "REOPEN_OR_REEVALUATE_ACCEPTED_PREDECESSOR_STATION",
        "CHANGE_WORKFLOW_OR_ARCHITECTURE",
        "CHANGE_QUALITY_GATES",
        "RESET_OR_REPLACE_TEST_STATE",
        "CREATE_ALTERNATIVE_ROUTE_OR_FALLBACK",
        "PERFORM_SUPERVISOR_OR_SYSTEM_FIXES",
        "DISCUSS_OR_SELECT_OTHER_CONCEPT_VERSIONS"
      ]
    }
  },
  "execution_discipline": {
    "mode": "WORKER_EXECUTES_ONLY_NEVER_SUPERVISES",
    "predecessor_rule": "AN_ACCEPTED_PREDECESSOR_PRODUCT_IS_AUTHORITATIVE_INPUT_FOR_THE_CURRENT_STATION",
    "failure_rule": "IF_THE_EXACT_STATION_CANNOT_BE_COMPLETED_RETURN_BLOCKED_WITH_THE_CONCRETE_INPUT_ERROR_ONLY",
    "routing_rule": "WORKER_NEVER_SELECTS_OR_STARTS_THE_NEXT_STATION",
    "system_change_rule": "WORKER_NEVER_CHANGES_ARCHITECTURE_WORKFLOW_QUALITY_GATES_OR_TEST_STATE"
  }
}
